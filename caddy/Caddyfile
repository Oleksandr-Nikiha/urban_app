# Caddyfile для Mini App та веб-сайтів мережі Urban Bites.
#
# Якщо задано змінну оточення APP_DOMAIN (наприклад, APP_DOMAIN=urban.example.com),
# Caddy автоматично отримує та оновлює TLS-сертифікат від Let's Encrypt / ZeroSSL,
# слухає порти 80 та 443, і автоматично перенаправляє весь трафік з HTTP на HTTPS.
# За відсутності APP_DOMAIN Caddy слухає порт 80 (HTTP) для локальної розробки.

{$APP_DOMAIN::80} {
	root * /srv
	encode gzip zstd

	# Примусовий редірект з HTTP на HTTPS при роботі за зовнішнім проксі/CDN/тунелем (X-Forwarded-Proto: http)
	@insecure_proto {
		header X-Forwarded-Proto http
	}
	redir @insecure_proto https://{host}{uri} permanent

	# Захисні заголовки
	# УВАГА: Telegram відкриває Mini App у WebView, а на Desktop — в iframe.
	# Дозволяємо відображення у фреймах лише всередині Telegram для захисту від клікджекінгу (SEC-10).
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org;"
	}

	# Окремий хендлер для завантаження фотографій адміністратором (дозволяє файли до 16 МБ)
	@upload path /api/admin/upload /api/admin/upload/*
	handle @upload {
		request_body {
			max_size 16MB
		}
		reverse_proxy api:8000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 60s
			}
		}
	}

	# Проксі API у контейнер FastAPI (ліміт звичайних клієнтських запитів — 2 МБ)
	@api path /api /api/*
	handle @api {
		request_body {
			max_size 2MB
		}

		# Довготривале кешування для роздачі медіа страв
		@uploads path /api/uploads/*
		header @uploads Cache-Control "public, max-age=2592000, immutable"

		reverse_proxy api:8000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	# Публічний сайт пекарні Urban Bakery & Coffee
	redir /croissant /croissant/
	redir /croissants /croissant/
	redir /croissants/* /croissant/
	handle /croissant/* {
		reverse_proxy web-croissants:80 {
			header_up Host {host}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	# Публічний сайт Urban Pizza & Sushi
	redir /pizza /pizza/
	redir /pizza/* /pizza/
	handle /pizza/* {
		reverse_proxy web-pizza:80 {
			header_up Host {host}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	# Портал мережі Urban Group та клубу лояльності Urban Club
	redir /club /group/
	redir /club/* /group/
	redir /group /group/
	handle /group/* {
		reverse_proxy web-group:80 {
			header_up Host {host}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	# Веб-панель адміністратора Urban Admin
	redir /admin /admin/
	handle /admin/* {
		reverse_proxy web-admin:80 {
			header_up Host {host}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	# Статика та SPA
	handle {
		# Кешування для асетів Vite (хешовані імена на кшталт app.a1b2c3d4.js — незмінні)
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# index.html не кешуємо: інакше після деплою користувач тягне старі ассети
		@index path /index.html
		header @index Cache-Control "no-cache, no-store, must-revalidate"

		# SPA-fallback: усі невідомі шляхи віддаємо роутеру на клієнті
		try_files {path} /index.html
		file_server
	}
}
